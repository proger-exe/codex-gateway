CODEX_API_TOKEN=change-me-long-random-token
CODEX_API_HOST=127.0.0.1
CODEX_API_PORT=8765
CODEX_API_ALLOWED_ROOT=/srv/workspaces
CODEX_API_DEFAULT_WORKSPACE=/srv/workspaces/default
CODEX_API_DEFAULT_SANDBOX=workspace-write
CODEX_API_DEFAULT_MODEL=gpt-5.4
CODEX_API_ALLOW_NETWORK=1
# For real read-only runs against the workspace above, move state/logs outside it.
CODEX_API_STATE_DIR=.codex-api
CODEX_API_SCHEMA_JSON_LIMIT=24000
CODEX_API_TIMEOUT_SECONDS=1200
CODEX_API_JOB_TIMEOUT_SECONDS=1800
